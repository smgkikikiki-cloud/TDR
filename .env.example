NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Required. At least 16 characters, random. Without it nobody can sign in to
# /admin at all — there is deliberately no fallback, so a value committed to
# the repo can never be used to forge an editor session.
ADMIN_SESSION_SECRET=choose-a-long-random-secret

# One shared password. The name typed at login is only a label in that case.
TDR_ADMIN_PASSWORD=choose-a-long-admin-password

# Or give each editor their own password, so the session records who is in.
# Takes priority over TDR_ADMIN_PASSWORD. Names and passwords cannot contain
# a comma; the name cannot contain a colon.
# TDR_ADMIN_USERS=somchai:password-one,nan:password-two
