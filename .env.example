NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY

# Server-only Supabase credential. Prefer the modern sb_secret_... key. The
# legacy service_role JWT remains supported for existing deployments.
SUPABASE_SECRET_KEY=YOUR_SB_SECRET_KEY
# SUPABASE_SERVICE_ROLE_KEY=YOUR_LEGACY_SERVICE_ROLE_KEY
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co

# Public origin used in Stripe Checkout/Portal redirects. Required in production.
TDR_APP_URL=https://example.com

# Stripe server credentials. The consumer catalogue remains free and does not
# need any of these values; they are used only by /member billing routes.
STRIPE_SECRET_KEY=sk_test_or_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_REGISTRATION_MONTHLY=price_...
# Optional: use a specific Customer Portal configuration instead of Stripe default.
# STRIPE_PORTAL_CONFIGURATION_ID=bpc_...
# Optional failed-renewal grace. 0 means entitlement expires on payment failure.
TDR_BILLING_GRACE_DAYS=0

# Required. At least 16 characters, random. Without it nobody can sign in to
# /admin at all — there is deliberately no fallback, so a value committed to
# the repo can never be used to forge an editor session.
ADMIN_SESSION_SECRET=choose-a-long-random-secret

# One shared password. The name typed at login is only a label in that case.
TDR_ADMIN_PASSWORD=choose-a-long-admin-password

# Or give each editor their own password, so the session records who is in.
# Takes priority over TDR_ADMIN_PASSWORD. Names and passwords cannot contain
# a comma; the name cannot contain a colon.
# TDR_ADMIN_USERS=somchai:password-one,nan:password-two
