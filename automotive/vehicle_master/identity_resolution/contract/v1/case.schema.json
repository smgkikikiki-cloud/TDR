{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tdr:identity-resolution:v1:case",
  "title": "Identity Resolution v1 — golden corpus line",
  "description": "One line of cases.jsonl. `kind` selects the engine layer under test; `input` is that layer's input and `expect` states only the invariants the contract promises (partial matching: anything not listed is unconstrained). Every case names the taxonomy ids it covers.",
  "$comment": "Validated by identity_resolution/contract/schema_subset.py against record.schema.json and decision.schema.json (cross-file $ref through a registry).",
  "type": "object",
  "required": ["id", "kind", "title", "taxonomy", "origin", "input", "expect"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z_]+\\.[a-z0-9][a-z0-9-]*$"},
    "kind": {"enum": ["resolve", "classify", "brand_relation", "name_tokens", "name_relation", "body_relation", "lifecycle_relation", "window", "series_gate", "lineage", "protection", "fingerprint", "band"]},
    "title": {"type": "string", "minLength": 1},
    "taxonomy": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"}},
    "origin": {"enum": ["owner_report_r6", "ice_m7_data", "design"]},
    "note": {"type": "string"},
    "legacy_note": {"type": "string"},
    "input": {"type": "object"},
    "expect": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "resolve"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "record.schema.json#/$defs/snapshot"}, "expect": {"$ref": "#/$defs/resolve_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "classify"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/classify_input"}, "expect": {"$ref": "#/$defs/decision_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "brand_relation"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/brand_relation_input"}, "expect": {"$ref": "#/$defs/brand_relation_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "name_tokens"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/name_tokens_input"}, "expect": {"$ref": "#/$defs/name_tokens_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "name_relation"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/name_relation_input"}, "expect": {"$ref": "#/$defs/name_relation_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "body_relation"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/body_relation_input"}, "expect": {"$ref": "#/$defs/body_relation_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "lifecycle_relation"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/lifecycle_relation_input"}, "expect": {"$ref": "#/$defs/lifecycle_relation_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "window"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/window_input"}, "expect": {"$ref": "#/$defs/window_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "series_gate"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/series_gate_input"}, "expect": {"$ref": "#/$defs/series_gate_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "lineage"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/lineage_case_input"}, "expect": {"$ref": "#/$defs/lineage_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "protection"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/protection_input"}, "expect": {"$ref": "#/$defs/protection_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "fingerprint"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/fingerprint_input"}, "expect": {"$ref": "#/$defs/fingerprint_expect"}}}
    },
    {
      "if": {"properties": {"kind": {"const": "band"}}, "required": ["kind"]},
      "then": {"properties": {"input": {"$ref": "#/$defs/band_input"}, "expect": {"$ref": "#/$defs/band_expect"}}}
    }
  ],
  "$defs": {
    "code_list": {
      "type": "array",
      "items": {"$ref": "decision.schema.json#/$defs/code"}
    },
    "range_or_value": {
      "anyOf": [
        {"type": "string"},
        {"type": "number"},
        {"type": "boolean"},
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min": {"type": "number"},
            "max": {"type": "number"}
          }
        }
      ]
    },
    "decision_expect": {
      "type": "object",
      "description": "Partial expectation on one resolution record. `evidence` maps a dotted path into the resolution (e.g. 'evidence.series.ratio', 'comparison.common_window.months') to an exact value or a {min,max} range.",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["AUTO", "PROPOSE", "AMBIGUOUS", "STRUCTURAL_REVIEW", "NO_CANDIDATE", "INSUFFICIENT_DATA", "PROTECTED_HOLD", "SUPPRESSED"]},
        "proposed_status": {"enum": ["AUTO", "PROPOSED", "NONE"]},
        "method": {"enum": ["SERIES", "NAME", "NONE"]},
        "primary_code": {"$ref": "decision.schema.json#/$defs/code"},
        "include": {"$ref": "#/$defs/code_list"},
        "exclude": {"$ref": "#/$defs/code_list"},
        "target_ids": {"type": "array", "items": {"type": "string"}},
        "review_required": {"type": "boolean"},
        "review_queue": {"enum": ["crosswalk_review", "structure_review", "discovery", "none"]},
        "review_priority": {"enum": ["low", "normal", "high"]},
        "writes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target_id", "action"],
            "additionalProperties": false,
            "properties": {
              "target_id": {"type": ["string", "null"]},
              "action": {"enum": ["INSERT_AUTO", "INSERT_PROPOSED", "PROMOTE_TO_AUTO", "REFRESH_EVIDENCE", "DEMOTE_TO_PROPOSED", "MARK_STALE", "BLOCK_REPORT", "SUPPRESS", "REOPEN_AS_PROPOSED", "KEEP", "NOOP"]}
            }
          }
        },
        "alternatives_min": {"type": "integer", "minimum": 0},
        "evidence": {"type": "object", "additionalProperties": {"$ref": "#/$defs/range_or_value"}}
      }
    },
    "operation_expect": {
      "type": "object",
      "required": ["op", "primary_code"],
      "additionalProperties": false,
      "properties": {
        "op": {"enum": ["REDIRECT", "MOVE_MAPPINGS", "FLAG_MAPPING_REVIEW", "QUARANTINE", "CANDIDATE_HINT", "NOOP", "ERROR"]},
        "old_id": {"type": "string"},
        "new_id": {"type": ["string", "null"]},
        "primary_code": {"$ref": "decision.schema.json#/$defs/code"},
        "include": {"$ref": "#/$defs/code_list"},
        "requires_owner_ack": {"type": "boolean"},
        "hint_target_ids": {"type": "array", "items": {"type": "string"}},
        "affects_protected": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "approved": {"type": "integer", "minimum": 0},
            "locked": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "resolve_expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decisions": {"type": "object", "additionalProperties": {"$ref": "#/$defs/decision_expect"}},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation_expect"}},
        "refusal": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {"code": {"$ref": "decision.schema.json#/$defs/code"}}
        }
      },
      "oneOf": [
        {"required": ["decisions"]},
        {"required": ["refusal"]}
      ]
    },
    "classify_subject": {
      "type": "object",
      "required": ["entity_id", "identity_status", "name_available", "total_units"],
      "additionalProperties": false,
      "properties": {
        "entity_id": {"type": "string", "minLength": 1},
        "identity_status": {"enum": ["settled", "provisional", "unmapped_name"]},
        "name_available": {"type": "boolean"},
        "total_units": {"type": "number", "minimum": 0},
        "multi_brand": {"type": "boolean"},
        "duplicate_display_name": {"type": "boolean"}
      }
    },
    "classify_candidate": {
      "type": "object",
      "required": ["target_ids", "evidence"],
      "additionalProperties": false,
      "properties": {
        "target_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "evidence": {"$ref": "decision.schema.json#/$defs/evidence"},
        "is_bundle": {"type": "boolean"},
        "bundle_overshoot": {"type": "boolean"},
        "held_elsewhere": {"enum": ["NONE", "UNPROTECTED", "PROTECTED"]},
        "pair_state": {"enum": ["NONE", "PROPOSED", "AUTO", "APPROVED", "LOCKED", "REJECTED"]},
        "rejected_fingerprint_unchanged": {"type": ["boolean", "null"]},
        "extends_protected": {"type": "boolean"}
      }
    },
    "classify_input": {
      "type": "object",
      "required": ["subject", "brand_known", "brand_in_tdr", "pool_size", "candidates"],
      "additionalProperties": false,
      "properties": {
        "subject": {"$ref": "#/$defs/classify_subject"},
        "quarantined": {"type": "boolean"},
        "brand_known": {"type": "boolean"},
        "brand_in_tdr": {"type": "boolean"},
        "pool_size": {"type": "integer", "minimum": 0},
        "candidates": {"type": "array", "items": {"$ref": "#/$defs/classify_candidate"}},
        "absent_existing": {
          "type": "array",
          "description": "Existing rows for this subject that the engine no longer produces (write-matrix column ABSENT).",
          "items": {
            "type": "object",
            "required": ["target_id", "pair_state"],
            "additionalProperties": false,
            "properties": {
              "target_id": {"type": "string"},
              "pair_state": {"enum": ["PROPOSED", "AUTO", "APPROVED", "LOCKED", "REJECTED"]}
            }
          }
        },
        "protected_targets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target_id", "state", "agrees"],
            "additionalProperties": false,
            "properties": {
              "target_id": {"type": "string"},
              "state": {"enum": ["APPROVED", "LOCKED"]},
              "agrees": {"enum": ["CONFIRMS", "CONTRADICTS", "INCONCLUSIVE"]},
              "target_exists": {"type": "boolean"}
            }
          }
        }
      }
    },
    "brand_relation_input": {
      "type": "object",
      "required": ["subject_brand", "target_brand"],
      "additionalProperties": false,
      "properties": {
        "subject_brand": {"type": "string"},
        "target_brand": {"type": "string"},
        "subject_brands_observed": {"type": "array", "items": {"type": "string"}}
      }
    },
    "brand_relation_expect": {
      "type": "object",
      "required": ["relation"],
      "additionalProperties": false,
      "properties": {
        "relation": {"enum": ["EXACT", "ALIAS_SAME", "ALIAS_RELABEL", "ALIAS_RELATED", "MISMATCH", "UNKNOWN"]},
        "alias_id": {"type": ["string", "null"]}
      }
    },
    "name_tokens_input": {
      "type": "object",
      "required": ["name", "brand"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "brand": {"type": "string"}
      }
    },
    "name_tokens_expect": {
      "type": "object",
      "required": ["tokens"],
      "additionalProperties": false,
      "properties": {
        "tokens": {"type": "array", "items": {"type": "string"}},
        "available": {"type": "boolean"},
        "prefix_stripped": {"type": "boolean"}
      }
    },
    "name_relation_input": {
      "type": "object",
      "required": ["subject_name", "subject_brand", "target_name", "target_brand"],
      "additionalProperties": false,
      "properties": {
        "subject_name": {"type": "string"},
        "subject_brand": {"type": "string"},
        "target_name": {"type": "string"},
        "target_brand": {"type": "string"}
      }
    },
    "name_relation_expect": {
      "type": "object",
      "required": ["relation"],
      "additionalProperties": false,
      "properties": {
        "relation": {"enum": ["EQUAL", "EQUAL_VIA_MODEL_ALIAS", "EQUAL_VIA_TOKEN_EQUIV", "FUZZY", "SUBJECT_COARSER", "SUBJECT_FINER", "SIBLING", "CONTRADICTION", "UNAVAILABLE"]},
        "score": {"$ref": "#/$defs/range_or_value"}
      }
    },
    "body_relation_input": {
      "type": "object",
      "required": ["provider_body", "tdr_body_type"],
      "additionalProperties": false,
      "properties": {
        "provider_body": {"type": ["string", "null"]},
        "tdr_body_type": {"type": ["string", "null"]}
      }
    },
    "body_relation_expect": {
      "type": "object",
      "required": ["body"],
      "additionalProperties": false,
      "properties": {"body": {"enum": ["MATCH", "MISMATCH", "UNKNOWN"]}}
    },
    "lifecycle_relation_input": {
      "type": "object",
      "required": ["subject_series", "generations", "as_of_period"],
      "additionalProperties": false,
      "properties": {
        "subject_series": {"anyOf": [{"$ref": "record.schema.json#/$defs/series"}, {"type": "null"}]},
        "generations": {"type": "array", "items": {"$ref": "record.schema.json#/$defs/generation"}},
        "as_of_period": {"$ref": "decision.schema.json#/$defs/period"}
      }
    },
    "lifecycle_relation_expect": {
      "type": "object",
      "required": ["lifecycle"],
      "additionalProperties": false,
      "properties": {
        "lifecycle": {"enum": ["WITHIN", "PARTIAL", "DISJOINT", "UNKNOWN"]},
        "share": {"$ref": "#/$defs/range_or_value"}
      }
    },
    "window_input": {
      "type": "object",
      "required": ["subject_series", "target_series"],
      "additionalProperties": false,
      "properties": {
        "subject_series": {"$ref": "record.schema.json#/$defs/series"},
        "target_series": {"$ref": "record.schema.json#/$defs/series"},
        "max_months": {"type": "integer", "minimum": 1}
      }
    },
    "window_expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "common_window": {
          "anyOf": [
            {"type": "null"},
            {
              "type": "object",
              "required": ["from", "to", "months"],
              "additionalProperties": false,
              "properties": {
                "from": {"$ref": "decision.schema.json#/$defs/period"},
                "to": {"$ref": "decision.schema.json#/$defs/period"},
                "months": {"type": "integer", "minimum": 1}
              }
            }
          ]
        },
        "excluded": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["period", "reason"],
            "additionalProperties": false,
            "properties": {
              "period": {"$ref": "decision.schema.json#/$defs/period"},
              "reason": {"type": "string"}
            }
          }
        },
        "series_state": {"enum": ["STRONG", "WEAK", "UNAVAILABLE"]},
        "series": {"type": "object", "additionalProperties": {"$ref": "#/$defs/range_or_value"}},
        "include": {"$ref": "#/$defs/code_list"},
        "exclude": {"$ref": "#/$defs/code_list"},
        "refusal": {"type": "string"}
      }
    },
    "series_gate_input": {
      "type": "object",
      "required": ["correlation", "ratio", "monthly_fit_share", "common_months", "joint_nonzero_months", "subject_units", "target_units"],
      "additionalProperties": false,
      "properties": {
        "correlation": {"type": "number"},
        "ratio": {"type": "number"},
        "monthly_fit_share": {"type": "number"},
        "common_months": {"type": "integer", "minimum": 0},
        "joint_nonzero_months": {"type": "integer", "minimum": 0},
        "subject_units": {"type": "number", "minimum": 0},
        "target_units": {"type": "number", "minimum": 0}
      }
    },
    "series_gate_expect": {
      "type": "object",
      "required": ["state"],
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["STRONG", "WEAK", "UNAVAILABLE"]},
        "include": {"$ref": "#/$defs/code_list"},
        "exclude": {"$ref": "#/$defs/code_list"}
      }
    },
    "lineage_case_input": {
      "type": "object",
      "required": ["provider", "source_version", "live_subject_ids", "lineage"],
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "minLength": 1},
        "source_version": {"$ref": "record.schema.json#/$defs/source_version"},
        "live_subject_ids": {"type": "array", "items": {"type": "string"}},
        "lineage": {"$ref": "record.schema.json#/$defs/lineage_input"},
        "existing_mappings": {"type": "array", "items": {"$ref": "record.schema.json#/$defs/existing_mapping"}}
      }
    },
    "lineage_expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exact": {"type": "boolean", "description": "true: the produced operations must be exactly the listed ones (by op, old_id, new_id, primary_code); false/absent: the listed ones must be present."},
        "operations": {"type": "array", "items": {"$ref": "#/$defs/operation_expect"}},
        "absent_operations": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["op", "old_id"],
            "additionalProperties": false,
            "properties": {
              "op": {"enum": ["REDIRECT", "MOVE_MAPPINGS", "FLAG_MAPPING_REVIEW", "QUARANTINE", "CANDIDATE_HINT", "NOOP", "ERROR"]},
              "old_id": {"type": "string"}
            }
          }
        },
        "refusal": {
          "type": "object",
          "required": ["code"],
          "additionalProperties": false,
          "properties": {"code": {"$ref": "decision.schema.json#/$defs/code"}}
        }
      }
    },
    "protection_input": {
      "type": "object",
      "required": ["existing_state", "decision", "fingerprint"],
      "additionalProperties": false,
      "properties": {
        "existing_state": {"enum": ["NONE", "PROPOSED", "AUTO", "APPROVED", "LOCKED", "REJECTED"]},
        "decision": {"enum": ["AUTO", "PROPOSE", "ABSENT"]},
        "fingerprint": {"enum": ["unchanged", "changed", "not_applicable"]}
      }
    },
    "protection_expect": {
      "type": "object",
      "required": ["action"],
      "additionalProperties": false,
      "properties": {
        "action": {"enum": ["INSERT_AUTO", "INSERT_PROPOSED", "PROMOTE_TO_AUTO", "REFRESH_EVIDENCE", "DEMOTE_TO_PROPOSED", "MARK_STALE", "BLOCK_REPORT", "SUPPRESS", "REOPEN_AS_PROPOSED", "KEEP", "NOOP"]},
        "mutates_protected_row": {"type": "boolean"}
      }
    },
    "fingerprint_input": {
      "type": "object",
      "required": ["fingerprint_kind", "payload"],
      "additionalProperties": false,
      "properties": {
        "fingerprint_kind": {"enum": ["decision", "evidence"]},
        "payload": {"type": "object"}
      }
    },
    "fingerprint_expect": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": {"$ref": "decision.schema.json#/$defs/sha256"},
        "same_digest_as": {"type": "string"},
        "different_digest_from": {"type": "string"},
        "error": {"enum": ["float_in_payload"]}
      }
    },
    "band_input": {
      "type": "object",
      "required": ["dimension", "value"],
      "additionalProperties": false,
      "properties": {
        "dimension": {"enum": ["correlation", "ratio", "name_score", "common_months"]},
        "value": {"type": "number"}
      }
    },
    "band_expect": {
      "type": "object",
      "required": ["band"],
      "additionalProperties": false,
      "properties": {"band": {"type": "string"}}
    }
  }
}
