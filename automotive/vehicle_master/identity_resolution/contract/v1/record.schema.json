{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tdr:identity-resolution:v1:record",
  "title": "Identity Resolution v1 — generic input snapshot",
  "description": "The ONLY shape the engine accepts. Provider adapters translate their native package into this; nothing here is Ice-specific. Periods are Gregorian ISO 'YYYY-MM'. A count of null means 'not observed' and is never read as zero.",
  "$comment": "Validated by identity_resolution/contract/schema_subset.py (a stdlib subset validator). Only the keywords that validator supports may appear here; a test fails if another keyword is added.",
  "$defs": {
    "period": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "nonempty_string": {
      "type": "string",
      "minLength": 1
    },
    "series": {
      "type": "object",
      "description": "Dense monthly counts starting at `start`. counts[i] is the month start+i. null = unobserved (outside the source's coverage), 0 = observed zero. coverage_declared=false means the source could not state its coverage, so the series yields no series evidence.",
      "required": ["start", "counts"],
      "additionalProperties": false,
      "properties": {
        "start": {"$ref": "#/$defs/period"},
        "counts": {
          "type": "array",
          "minItems": 1,
          "items": {"type": ["number", "null"]}
        },
        "partial_periods": {
          "type": "array",
          "items": {"$ref": "#/$defs/period"}
        },
        "coverage_declared": {"type": "boolean"}
      }
    },
    "subject": {
      "type": "object",
      "description": "A provider-side identity being resolved (Ice: one model_group).",
      "required": ["entity_kind", "entity_id", "display_name", "brand", "identity_status"],
      "additionalProperties": false,
      "properties": {
        "entity_kind": {"$ref": "#/$defs/nonempty_string"},
        "entity_id": {"$ref": "#/$defs/nonempty_string"},
        "display_name": {"type": "string"},
        "brand": {"type": "string"},
        "brands_observed": {
          "type": "array",
          "items": {"type": "string"}
        },
        "identity_status": {"enum": ["settled", "provisional", "unmapped_name"]},
        "attributes": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "body": {"type": ["string", "null"]}
          }
        },
        "series": {"anyOf": [{"$ref": "#/$defs/series"}, {"type": "null"}]}
      }
    },
    "generation": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": {"$ref": "#/$defs/nonempty_string"},
        "launched": {"anyOf": [{"$ref": "#/$defs/period"}, {"type": "null"}]},
        "ended": {"anyOf": [{"$ref": "#/$defs/period"}, {"type": "null"}]}
      }
    },
    "target": {
      "type": "object",
      "description": "A TDR-side canonical entity (v1: a vehicle_models row).",
      "required": ["target_kind", "target_id", "brand", "display_name", "status", "deleted"],
      "additionalProperties": false,
      "properties": {
        "target_kind": {"$ref": "#/$defs/nonempty_string"},
        "target_id": {"$ref": "#/$defs/nonempty_string"},
        "brand": {"type": "string"},
        "display_name": {"type": "string"},
        "status": {"enum": ["CURRENT", "HISTORICAL", "UNVERIFIED"]},
        "deleted": {"type": "boolean"},
        "body_type": {"type": ["string", "null"]},
        "generations": {
          "type": "array",
          "items": {"$ref": "#/$defs/generation"}
        },
        "series": {"anyOf": [{"$ref": "#/$defs/series"}, {"type": "null"}]}
      }
    },
    "existing_mapping": {
      "type": "object",
      "description": "Persisted state the engine must respect. REJECTED/APPROVED/LOCKED are human decisions.",
      "required": ["subject_id", "target_id", "state"],
      "additionalProperties": false,
      "properties": {
        "subject_id": {"$ref": "#/$defs/nonempty_string"},
        "target_id": {"type": ["string", "null"]},
        "state": {"enum": ["PROPOSED", "AUTO", "APPROVED", "LOCKED", "REJECTED"]},
        "evidence_fingerprint": {"type": ["string", "null"]}
      }
    },
    "lineage_event": {
      "type": "object",
      "description": "A provider-declared identity change. Ice: เปลี่ยนรหัส=RENAME, รวม=MERGE, แยก=SPLIT.",
      "required": ["event_type", "old_id", "new_id"],
      "additionalProperties": false,
      "properties": {
        "event_type": {"enum": ["RENAME", "MERGE", "SPLIT"]},
        "old_id": {"$ref": "#/$defs/nonempty_string"},
        "new_id": {"$ref": "#/$defs/nonempty_string"},
        "share_of_old_pct": {"type": ["number", "null"]},
        "successor_id": {"type": ["string", "null"]}
      }
    },
    "lineage_input": {
      "type": "object",
      "required": ["source_present", "declared_identity_change", "events"],
      "additionalProperties": false,
      "properties": {
        "source_present": {"type": "boolean"},
        "declared_identity_change": {"type": "boolean"},
        "events": {
          "type": "array",
          "items": {"$ref": "#/$defs/lineage_event"}
        },
        "applied_event_keys": {
          "type": "array",
          "items": {"type": "string"}
        }
      }
    },
    "source_version": {
      "type": "object",
      "required": ["label"],
      "additionalProperties": false,
      "properties": {
        "label": {"type": "string"},
        "attributes": {"type": "object"}
      }
    },
    "snapshot": {
      "type": "object",
      "required": ["contract_version", "policy_version", "provider", "source_version", "as_of_period", "subjects", "targets"],
      "additionalProperties": false,
      "properties": {
        "contract_version": {"const": "v1"},
        "policy_version": {"$ref": "#/$defs/nonempty_string"},
        "provider": {"$ref": "#/$defs/nonempty_string"},
        "source_version": {"$ref": "#/$defs/source_version"},
        "as_of_period": {"$ref": "#/$defs/period"},
        "subjects": {
          "type": "array",
          "items": {"$ref": "#/$defs/subject"}
        },
        "targets": {
          "type": "array",
          "items": {"$ref": "#/$defs/target"}
        },
        "existing_mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/existing_mapping"}
        },
        "lineage": {"$ref": "#/$defs/lineage_input"}
      }
    }
  }
}
