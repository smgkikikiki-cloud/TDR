{"$schema":"https://json-schema.org/draft/2020-12/schema","title":"Recorded evidence document v1","type":"object","required":["schema_version","document_id","source_id","source_authority","market","model_id","generation_id","trim_ids","local_source_id","content","content_sha256","captured_at","completeness","source_kind","extraction_method"],"properties":{"schema_version":{"const":"1.0"},"document_id":{"type":"string","minLength":1},"source_id":{"type":"string","minLength":1},"source_authority":{"enum":["OFFICIAL","ADMIN","SECONDARY"]},"market":{"enum":["TH","OTHER"]},"model_id":{"type":"string"},"generation_id":{"type":"string"},"trim_ids":{"type":"array","items":{"type":"string"},"uniqueItems":true},"local_source_id":{"type":"string","minLength":1},"content":{"type":"string"},"content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"published_at":{"type":["string","null"],"format":"date"},"captured_at":{"type":"string","format":"date"},"completeness":{"enum":["COMPLETE_LINEUP","PARTIAL_TRIM_LIST","INDIVIDUAL_TRIM","SPEC_ONLY"]},"source_kind":{"type":"string"},"lineage_id":{"type":"string"},"trim_variant_ids":{"type":"object","additionalProperties":{"type":"string"}},"powertrain_by_trim":{"type":"object","additionalProperties":{"type":"string"}},"model_year_by_trim":{"type":"object","additionalProperties":{"type":"integer"}},"extraction_method":{"const":"CONTROLLED_LINE_READER_V1"},"capture_manifest":{"type":"object","required":["pagination_complete","source_page_count","row_count","listed_trim_ids"],"properties":{"pagination_complete":{"type":"boolean"},"source_page_count":{"type":"integer","minimum":0},"row_count":{"type":"integer","minimum":0},"listed_trim_ids":{"type":"array","items":{"type":"string"}}}}},"allOf":[{"if":{"properties":{"completeness":{"enum":["COMPLETE_LINEUP","PARTIAL_TRIM_LIST"]}},"required":["completeness"]},"then":{"required":["capture_manifest"]}}]}
